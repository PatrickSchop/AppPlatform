<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Central package management requires source mapping once a second source exists (NU1507).
       app-build.yaml adds a credentialed "PS" source in CI; PS.AppPlatform* resolves from it,
       everything else from nuget.org. Sources themselves are inherited, not redefined here. -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="PS">
      <package pattern="PS.AppPlatform*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
