{
  "staticContent": {
    "files": {
      "rootPath": "../../../../wwwroot"
    }
  },
  "database": {
    "connectionString": "Server=(localdb)\\.;Database=TinyApp;Trusted_Connection=true;TrustServerCertificate=True",
    "useManagedIdentity": false,
    "apiMigration": {
      "enable": true
    }
  },
  "azureIdentity": {},
  "httpAccessControl": {
    "allowOrigin": "http://localhost:4200,http://localhost:5173"
//#if (TenancyEnabled)
  },
  "tenancy": {
    "directory": "config",
    "_comment": "Local development reads users, tenants and roles from this file instead of the management app. Replace the zero oid/tid with yours: sign in once and read them from the 'No access' page, or from your token (claims oid and tid). Keep the real values out of the repository (local.settings.json is git-ignored).",
    "devDirectory": {
      "tenants": [
        { "id": "11111111-1111-1111-1111-111111111111", "name": "Dev tenant" }
      ],
      "users": [
        {
          "id": "33333333-3333-3333-3333-333333333333",
          "oid": "00000000-0000-0000-0000-000000000000",
          "tid": "00000000-0000-0000-0000-000000000000",
          "displayName": "Developer",
          "memberships": [
            { "tenantId": "11111111-1111-1111-1111-111111111111", "roles": [ "editor" ] }
          ]
        }
      ]
    }
  }
//#else
  }
//#endif
}
