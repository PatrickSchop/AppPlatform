<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- GitHub Packages for PS.AppPlatform (requires GitHub token configured in credentials) -->
    <!-- See docs/consuming-packages.md in the PS.AppPlatform repository for setup instructions -->
    <add key="github" value="https://nuget.pkg.github.com/PatrickSchop/index.json" />
    <!-- NuGet.org for all other packages -->
    <add key="nuget" value="https://api.nuget.org/v3/index.json" />
  </packageSources>

  <!-- Package source mapping for central package management with multiple sources -->
  <packageSourceMapping>
    <packageSource key="github">
      <package pattern="PS.AppPlatform*" />
    </packageSource>
    <packageSource key="nuget">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

  <!-- GitHub Packages credentials -->
  <packageSourceCredentials>
    <github>
      <add key="Username" value="USERNAME" />
      <add key="ClearTextPassword" value="TOKEN" />
    </github>
  </packageSourceCredentials>
</configuration>
