{
  "webApp": {
    "api": {
      "root": "/api"
    },
    "title": "Application Management"
  },
  "authentication": {
    "azureEntraId": {
      "tenantId": "common",
      "clientId": "00000000-0000-0000-0000-000000000000",
      "additionalAudiences": [ "api://00000000-0000-0000-0000-000000000000" ]
    },
    "requiredRole": "admin"
  },
  "database": {
    "connectionString": "",
    "useManagedIdentity": false,
    "apiMigration": {
      "enable": false
    }
  },
  "backgroundTasks": {
    "maxConcurrentTasks": 4,
    "leaseSeconds": 300
  },
  "tenancy": {
    "mode": "Single",
    "directory": "local"
  },
  "registry": {
    "trustedTenantId": "",
    "trustedDeployers": []
  }
}
